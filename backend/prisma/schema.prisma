generator client {
  provider = "prisma-client-js"
  output   = "../src/v2/generated"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/v2/generated/zod"
}

datasource db {
  provider = "postgresql"
  url      = env("DATASOURCE_URL")
}

// --- ENUMS ---

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum RaceStatus {
  WAITING
  STARTED
  FINISHED
  CLOSED
  CANCELLED
}

enum ListingStatus {
  FOR_SALE
  TRADING
  SOLD
  EXPIRED
}

enum CarRarity {
  LEGENDARY
  RARE
  JUNK
}

enum OilStatus {
  GOOD
  MEDIUM
  BAD
}

enum DealStatus {
  PENDING
  WAITING_FOR_FINISH
  COMPLETED
  CANCELLED
  CLOSED_WITH_PENALTY
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum VerificationCodeType {
  WEB_LOGIN
  PASSWORD_RESET
  GAME_LOGIN
}

enum AuctionStatus {
  CREATED
  OPEN
  FINISHED
  CANCELLED
}

enum SlotType {
  OPEN
  CLOSED
  LUCKY
}

enum RaceType {
  FREE
  PAID
}

enum DisqualificationReason {
  NOT_IN_START_ZONE
  CHEATING_SUSPECT
  TELEPORT
  SPEEDHACK
}

enum EntityType {
  CAR
  HOUSE
  BUSINESS
}

enum EvidenceFileType {
  PHOTO
  VIDEO
  FILE
}

enum PrizeType {
  MONEY
  POINTS
  CUSTOM
}

// --- MODELS ---

model User {
  id             Int       @id @default(autoincrement())
  telegram_id    BigInt    @unique
  username       String?
  created_at     DateTime  @default(now())
  vip_expires_at DateTime?

  role UserRole @default(USER)

  points         BigInt @default(0)
  frozen_points  BigInt @default(0)
  balance        BigInt @default(0)
  frozen_balance BigInt @default(0)
  reputation     Int    @default(100)

  banned_until  DateTime?
  ban_reason    String?
  token_version Int       @default(0)

  // Связи
  game_accounts     GameAccount[]
  created_races     Race[]             @relation("UserCreatedRaces")
  won_races         Race[]             @relation("RaceWinner")
  settings          UserSettings?
  tokens            Tokens[]
  verificationCodes VerificationCodes?

  // Marketplace
  marketplace_items MarketplaceItem[] @relation("UserListings")
  buyer_deals       MarketplaceDeal[] @relation("BuyerDeals")
  reports_filed     Report[]          @relation("Reporter")
  reports_against   Report[]          @relation("Target")

  // Гонки и аукционы
  won_slots        AuctionSlot[]
  auction_bids     AuctionBid[]
  race_bets        RaceBet[]
  raceParticipants RaceParticipant[]
}

model VerificationCodes {
  id          Int                  @id @default(autoincrement())
  telegram_id BigInt               @unique
  code        String               @unique
  type        VerificationCodeType
  expires_at  DateTime

  user User @relation(fields: [telegram_id], references: [telegram_id])
}

model UserSettings {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  updated_at DateTime @updatedAt
}

model GameAccount {
  id       Int     @id @default(autoincrement())
  game_id  Int
  nickname String
  server   Int
  level    Int
  is_main  Boolean @default(false)

  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  received_bets  RaceBet[]
  participations RaceParticipant[]
  car_listings   CarListing[]
  won_race_refs  Race[]            @relation("GameAccountWinner")

  @@unique([game_id, server])
  @@index([user_id])
}

// --- Marketplace V2 ---

model MarketplaceItem {
  id          Int        @id @default(autoincrement())
  entity_type EntityType

  is_boosted  Boolean   @default(false)
  boost_until DateTime? // Время, до которого товар будет в ТОПе

  seller_id Int
  seller    User @relation("UserListings", fields: [seller_id], references: [id], onDelete: Cascade)

  title       String
  price       BigInt
  server      Int
  description String?
  status      ListingStatus @default(FOR_SALE)

  // Детализация
  car_details   CarListing?
  house_details HouseListing?

  // Сделка
  deal MarketplaceDeal?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([entity_type, server, price])
  @@index([is_boosted, boost_until])
  @@map("marketplace_items")
}

model CarListing {
  id      Int             @id @default(autoincrement())
  item_id Int             @unique
  item    MarketplaceItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  account_id Int
  account    GameAccount @relation(fields: [account_id], references: [id])

  model_id     Int
  rarity       CarRarity @default(JUNK)
  rarity_num   Int       @default(0)
  plate_number String?
  mileage      Float     @default(0.0)
  oil_status   OilStatus @default(GOOD)
  condition    Int       @default(100)
  has_launch   Boolean   @default(false)
  image_id     String?

  is_negotiable Boolean @default(false)
  is_vice_city  Boolean @default(false)

  @@index([rarity, rarity_num])
  @@map("car_listings_details")
}

model HouseListing {
  id      Int             @id @default(autoincrement())
  item_id Int             @unique
  item    MarketplaceItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  house_number Int
  location     String
  has_garage   Boolean @default(false)

  @@map("house_listings_details")
}

model MarketplaceDeal {
  id      Int             @id @default(autoincrement())
  item_id Int             @unique
  item    MarketplaceItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  buyer_id Int
  buyer    User @relation("BuyerDeals", fields: [buyer_id], references: [id])

  // --- КОНТАКТ ---
  // Продавец нажимает "Да, он мне написал"
  seller_confirmed_contact Boolean @default(false)
  // Покупатель нажимает "Да, он мне ответил"
  buyer_confirmed_contact  Boolean @default(false)

  // --- ЗАВЕРШЕНИЕ СДЕЛКИ ---
  // Продавец нажал "Подтвердить продажу"
  seller_confirmed_deal Boolean @default(false)
  // Покупатель нажал "Подтвердить покупку"
  buyer_confirmed_deal  Boolean @default(false)

  // --- ДОСРОЧНОЕ ЗАКРЫТИЕ  ---
  // Если оба предложили закрыть без последствий
  seller_wants_to_close Boolean @default(false)
  buyer_wants_to_close  Boolean @default(false)

  status DealStatus @default(PENDING)

  // Дедлайны 
  buyer_contact_deadline DateTime // +1 час с момента создания
  seller_action_deadline DateTime // +24 часа для продавца (нажать, что покупатель НЕ написал)

  reports Report[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("marketplace_deals")
}

model Report {
  id          Int  @id @default(autoincrement())
  reporter_id Int
  reporter    User @relation("Reporter", fields: [reporter_id], references: [id])
  target_id   Int
  target      User @relation("Target", fields: [target_id], references: [id])

  deal_id Int?
  deal    MarketplaceDeal? @relation(fields: [deal_id], references: [id])

  reason String
  status ReportStatus @default(OPEN)

  evidences ReportEvidence[]

  created_at DateTime @default(now())

  @@map("reports")
}

model ReportEvidence {
  id        Int    @id @default(autoincrement())
  report_id Int
  report    Report @relation(fields: [report_id], references: [id], onDelete: Cascade)

  tg_file_id String

  file_type EvidenceFileType @default(PHOTO)

  created_at DateTime @default(now())

  @@map("report_evidences")
}

// --- RACE & OTHERS ---

model Location {
  id        Int    @id @default(autoincrement())
  name      String
  file_id   String
  pos_one_x Float
  pos_one_y Float
  pos_one_z Float
  pos_two_x Float
  pos_two_y Float
  pos_two_z Float
  races     Race[]
}

model Race {
  id          Int        @id @default(autoincrement())
  secret_code String     @unique
  status      RaceStatus @default(WAITING)

  location_id Int
  location    Location @relation(fields: [location_id], references: [id])

  winner_acc_id  Int?
  winner_acc GameAccount? @relation("GameAccountWinner", fields: [winner_acc_id], references: [id], onDelete: SetNull)

  winner_user_id Int?
  winner_user    User? @relation("RaceWinner", fields: [winner_user_id], references: [id])

  prize      String
  prize_type PrizeType

  winner_path Json?
  start_at    DateTime

  creator_id Int?
  creator    User? @relation("UserCreatedRaces", fields: [creator_id], references: [id])

  race_bets    RaceBet[]
  participants RaceParticipant[]
  auction      Auction?
  created_at   DateTime          @default(now())

  @@index([status, start_at])
}

model RaceParticipant {
  id      Int  @id @default(autoincrement())
  race_id Int
  race    Race @relation(fields: [race_id], references: [id], onDelete: Cascade)

  is_disqualified Boolean                 @default(false)
  disqualified_at DateTime?
  dq_reason       DisqualificationReason?

  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  game_account_id Int
  game_account    GameAccount @relation(fields: [game_account_id], references: [id], onDelete: Cascade)

  finished         Boolean        @default(false)
  position         Int?
  server_finish_at DateTime?
  telemetry        RaceTelemetry?

  @@unique([race_id, user_id])
}

model RaceTelemetry {
  id             Int             @id @default(autoincrement())
  participant_id Int             @unique
  participant    RaceParticipant @relation(fields: [participant_id], references: [id], onDelete: Cascade)

  raw_path   Json?
  speed      Float
  created_at DateTime @default(now())
}

model Tokens {
  id            Int      @id @default(autoincrement())
  user_id       Int      @unique
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_token String   @unique
  created_at    DateTime @default(now())
}

model Auction {
  id      Int           @id @default(autoincrement())
  title   String        @default("ГРАН-ПРИ [ЛОКАЦИЯ]")
  status  AuctionStatus @default(CREATED)
  race_id Int?          @unique
  race    Race?         @relation(fields: [race_id], references: [id])

  start_at     DateTime
  end_at       DateTime
  min_bid_step Int      @default(5)

  slots      AuctionSlot[]
  bids       AuctionBid[]
  created_at DateTime      @default(now())
}

model AuctionSlot {
  id         Int      @id @default(autoincrement())
  auction_id Int
  auction    Auction  @relation(fields: [auction_id], references: [id], onDelete: Cascade)
  number     Int
  type       SlotType @default(CLOSED)

  winner_id Int?
  winner    User? @relation(fields: [winner_id], references: [id])

  @@unique([auction_id, number])
}

model AuctionBid {
  id          Int      @id @default(autoincrement())
  auction_id  Int
  auction     Auction  @relation(fields: [auction_id], references: [id], onDelete: Cascade)
  user_id     Int
  user        User     @relation(fields: [user_id], references: [id])
  is_active   Boolean  @default(true)
  slot_number Int
  amount      Int
  created_at  DateTime @default(now())

  @@index([auction_id, slot_number, amount])
}

model RaceBet {
  id Int @id @default(autoincrement())

  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  race_id Int
  race    Race @relation(fields: [race_id], references: [id], onDelete: Cascade)

  target_acc_id  Int
  target_account GameAccount @relation(fields: [target_acc_id], references: [id])

  amount BigInt

  is_win        Boolean?
  payout_amount BigInt?

  created_at DateTime @default(now())

  @@index([race_id, target_acc_id])
}
